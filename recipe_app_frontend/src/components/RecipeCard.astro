---
import Badge from "./Badge.astro";
export interface Props {
  href: string;
  title: string;
  description: string;
  image: string;
  time: string;
  difficulty: string;
  tags?: string[];
}
const { href, title, description, image, time, difficulty, tags = [] } = Astro.props as Props;
---

<a class="card" href={href}>
  <div class="thumb">
    <img src={image} alt={title} loading="lazy" />
    <div class="chip time">⏱ {time}</div>
    <div class="chip diff">{difficulty}</div>
  </div>
  <div class="body">
    <h3 class="title">{title}</h3>
    <p class="desc">{description}</p>
    {tags.length > 0 && (
      <div class="tags">
        {tags.slice(0, 3).map((t) => <Badge label={t} tone="neutral" />)}
      </div>
    )}
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    border: 1px solid var(--border-color);
    background: var(--surface);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 6px 16px var(--shadow-color);
    transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
  }
  .card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in oklab, var(--color-primary) 30%, var(--border-color));
    box-shadow: 0 10px 24px var(--shadow-hover-color);
  }

  .thumb { position: relative; aspect-ratio: 16 / 10; background: var(--surface-elev); }
  .thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .chip {
    position: absolute; top: 10px; left: 10px;
    background: color-mix(in oklab, var(--surface) 70%, transparent);
    border: 1px solid var(--border-color);
    padding: 4px 8px; border-radius: 999px; font-size: 12px; color: var(--text);
    backdrop-filter: blur(6px);
  }
  .chip.diff { left: auto; right: 10px; }

  .body { padding: 14px; display: grid; gap: 8px; }
  .title { margin: 0; color: var(--text); font-size: 18px; }
  .desc { margin: 0; color: var(--text-secondary); font-size: 14px; }
  .tags { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 4px; }
</style>

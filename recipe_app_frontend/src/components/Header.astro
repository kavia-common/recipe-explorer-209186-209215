---
const siteName = "Recipe Explorer";
const tagline = "Discover. Cook. Enjoy.";
const primary = "var(--color-primary)";
const secondary = "var(--color-secondary)";
---

<header class="header">
  <div class="brand">
    <a href="/" class="logo">
      <div class="logo-mark" aria-hidden="true">🍳</div>
      <div class="text">
        <span class="name">{siteName}</span>
        <span class="tagline">{tagline}</span>
      </div>
    </a>
  </div>
  <nav class="nav">
    <a href="/" class="nav-link">Home</a>
    <a href="/about" class="nav-link muted" aria-disabled="true">About</a>
  </nav>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(12px);
    background:
      linear-gradient(120deg, color-mix(in oklab, {primary} 6%, transparent), transparent),
      var(--surface);
    border-bottom: 1px solid var(--border-color);
    padding: 14px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    display: flex;
    gap: 12px;
    text-decoration: none;
    align-items: center;
  }

  .logo-mark {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background:
      radial-gradient(120px 120px at 10% 10%, color-mix(in oklab, var(--color-secondary) 35%, transparent), transparent),
      radial-gradient(120px 120px at 80% 20%, color-mix(in oklab, var(--color-primary) 30%, transparent), transparent),
      var(--surface-elev);
    display: grid;
    place-items: center;
    box-shadow: 0 6px 18px var(--shadow-color);
    transition: transform .25s ease, box-shadow .25s ease;
  }
  .logo:hover .logo-mark { transform: translateY(-1px); box-shadow: 0 10px 24px var(--shadow-hover-color); }

  .text { display: flex; flex-direction: column; line-height: 1; }
  .name { font-weight: 800; color: var(--text); letter-spacing: .3px; }
  .tagline { font-size: 12px; color: var(--text-secondary); }

  .nav { display: flex; gap: 16px; }
  .nav-link {
    color: var(--text);
    text-decoration: none;
    padding: 8px 12px;
    border-radius: 10px;
    transition: background-color .2s ease, color .2s ease;
  }
  .nav-link:hover { background-color: var(--surface-elev); }
  .nav-link.muted { color: var(--text-muted); cursor: not-allowed; }
</style>
